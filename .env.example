# ======================================
# APPLICATION SUPPORT AGENT - CONFIGURATION
# ======================================

# -------- Database (MySQL) --------
DB_HOST=localhost
DB_NAME=ouroboros_application_db
DB_USERNAME=ouroboros_app
DB_PASSWORD=change_this_app_db_password
DB_PORT=3306

# Docker Compose creates/uses this non-root app DB user.
MYSQL_ROOT_PASSWORD=root_password
APP_DB_USERNAME=ouroboros_app
APP_DB_PASSWORD=change_this_app_db_password

DB_POOL_SIZE=10
DB_POOL_NAME=application_support_pool
DB_CONNECTION_TIMEOUT=20

# Docker MySQL port (host-side)
DOCKER_MYSQL_PORT=3311

# -------- Inter-Service Authentication --------
# Orchestrator calls protected endpoints with Authorization: Bearer <short-lived JWT>.
# Local/dev default is false so the service can boot before keys are configured.
INTERNAL_TOKEN_VERIFY_ENABLED=false
INTERNAL_TOKEN_SIGNING_ALGORITHM=RS256
INTERNAL_TOKEN_AUDIENCE=ouroboros.application-support
INTERNAL_TOKEN_ISSUER=ouroboros-orchestrator-internal
# Prefer JWKS in Docker/Kubernetes so key rotation is centralized in orchestrator.
INTERNAL_TOKEN_JWKS_URL=http://orchestrator:8000/internal/.well-known/jwks.json
INTERNAL_TOKEN_JWKS_REFRESH_SECONDS=60
INTERNAL_TOKEN_JWKS_TIMEOUT_SECONDS=2
# Optional fallback when JWKS is not available. Preserve PEM newlines as \n if stored on one line.
INTERNAL_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nINTERNAL_SIGNING_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
INTERNAL_TOKEN_PUBLIC_KEYS={"internal-v1":"-----BEGIN PUBLIC KEY-----\nINTERNAL_SIGNING_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"}

# -------- LLM Configuration --------
# Primary: OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.2

# Fallback: Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=2000

# Retry
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2

# -------- SOP Generation --------
SOP_MIN_WORDS=500
SOP_MAX_WORDS=800
SOP_QUALITY_THRESHOLD=0.7

# -------- Document Generation --------
DOCX_TEMPLATE_DIR=templates/docx
OUTPUT_DIR=/tmp/outputs

# -------- File uploads (DOCX / future uploads) --------
MAX_FILE_SIZE_MB=10
TEMP_UPLOAD_DIR=/tmp/uploads
# ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.jpg,.jpeg,.png

# -------- Retrieval (Style Reference) --------
RETRIEVAL_TOP_K=2
RETRIEVAL_ENABLED=true

# -------- Security (CRITICAL) --------
MAX_INPUT_LENGTH=10000
ENABLE_PROMPT_INJECTION_DETECTION=true
ENABLE_OUTPUT_VALIDATION=true

# -------- Application --------
ENVIRONMENT=development
LOG_LEVEL=INFO
USE_MOCK_DATA=false
ALLOW_DB_FAILURE=false

# Optional: periodic job marks reminder_sent for pending deadlines in the next 30 days (requires DB).
DEADLINE_REMINDER_SCHEDULER_ENABLED=false
DEADLINE_REMINDER_INTERVAL_MINUTES=360
