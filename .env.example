# ======================================
# APPLICATION SUPPORT AGENT - CONFIGURATION
# ======================================

# -------- Database (MySQL) --------
DB_HOST=localhost
DB_NAME=ouroboros_application_db
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_PORT=3306

DB_POOL_SIZE=10
DB_POOL_NAME=application_support_pool
DB_CONNECTION_TIMEOUT=20

# Docker MySQL port (host-side)
DOCKER_MYSQL_PORT=3308

# -------- Inter-Service Authentication --------
X_SERVICE_TOKEN=your-super-secret-service-token-here-change-this

# -------- LLM Configuration --------
# Primary: OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.2

# Fallback: Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=2000

# Retry
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2

# -------- SOP Generation --------
SOP_MIN_WORDS=500
SOP_MAX_WORDS=800
SOP_QUALITY_THRESHOLD=0.7

# -------- Document Generation --------
DOCX_TEMPLATE_DIR=templates/docx
OUTPUT_DIR=/tmp/outputs

# -------- File uploads (DOCX / future uploads) --------
MAX_FILE_SIZE_MB=10
TEMP_UPLOAD_DIR=/tmp/uploads
# ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.jpg,.jpeg,.png

# -------- Retrieval (Style Reference) --------
RETRIEVAL_TOP_K=2
RETRIEVAL_ENABLED=true

# -------- Security (CRITICAL) --------
MAX_INPUT_LENGTH=10000
ENABLE_PROMPT_INJECTION_DETECTION=true
ENABLE_OUTPUT_VALIDATION=true

# -------- Application --------
ENVIRONMENT=development
LOG_LEVEL=INFO
USE_MOCK_DATA=false
ALLOW_DB_FAILURE=false

# Optional: periodic job marks reminder_sent for pending deadlines in the next 30 days (requires DB).
DEADLINE_REMINDER_SCHEDULER_ENABLED=false
DEADLINE_REMINDER_INTERVAL_MINUTES=360
